# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Both values are safe to ship to the browser (RLS protects the data).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service-role key in any VITE_ variable or in this repo's frontend.
